<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The suite asserts on runlog's own error paths, several of which are
         "this input is rejected". Warnings-as-errors here would only fight the
         test code; runlog itself keeps FS0025. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Harness.fs" />
    <Compile Include="VerdictTests.fs" />
    <Compile Include="CliTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test-only. runlog and gather keep their "No PackageReference by design"
         stance: this never enters either tool's runtime closure. -->
    <PackageReference Include="Expecto" Version="10.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../runlog/runlog.fsproj" />
  </ItemGroup>

</Project>
