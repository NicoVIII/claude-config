<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- No PackageReference by design: System.Text.Json decodes gh's output
         strictly on its own once RespectRequiredConstructorParameters is set,
         and Process/Async cover the rest. -->
  </PropertyGroup>

  <!-- Compile order is the architecture: every file may reference only files
       above it, so the dependency direction is checked by the compiler. -->
  <ItemGroup>
    <Compile Include="Gh.fs" />
    <Compile Include="Wire.fs" />
    <Compile Include="Domain.fs" />
    <Compile Include="Signals.fs" />
    <Compile Include="Render.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

</Project>
