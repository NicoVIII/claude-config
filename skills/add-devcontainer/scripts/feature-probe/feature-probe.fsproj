<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Domain.fs names the three things a registry can do with a request, and
         "refused" and "unreachable" must never be decided by the same branch:
         one is an answer about the feature, the other is the network. An
         incomplete match on them has to stop the build, not warn. -->
    <WarningsAsErrors>FS0025</WarningsAsErrors>
  </PropertyGroup>

  <!-- Compile order is the architecture: every file may reference only files
       above it, so the dependency direction is checked by the compiler. -->
  <ItemGroup>
    <Compile Include="Domain.fs" />
    <Compile Include="Cli.fs" />
    <Compile Include="Json.fs" />
    <Compile Include="Http.fs" />
    <Compile Include="Registry.fs" />
    <Compile Include="Render.fs" />
    <Compile Include="Run.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

</Project>
