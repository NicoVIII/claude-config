<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="FakeRegistry.fs" />
    <Compile Include="RunTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test-only: this never enters the tool's runtime closure. -->
    <PackageReference Include="Expecto" Version="11.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../feature-probe/feature-probe.fsproj" />
  </ItemGroup>

</Project>
