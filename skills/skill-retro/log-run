#!/usr/bin/env sh
# Appends one entry to a skill's run log.
#
# Date, repo and file creation are mechanical and had been patched four times as
# SKILL.md prose (45ad1bb, 55146ed, f00f040) before moving here. The verdict is
# the retro's judgement and has to be passed in.
#
# The repo is the one the session ran in — for a cross-repo skill, still where
# the session ran, not the repos it touched. That is what running `git` from the
# working directory gives, which is why it is not derived from the skill path.
set -eu

if [ $# -ne 2 ]; then
    echo "usage: log-run <skill> <verdict>" >&2
    echo "  e.g. log-run grilling 'minor: footer placement guessed'" >&2
    exit 1
fi

log="$(dirname "$0")/../$1/RUNS.md"

if [ ! -d "$(dirname "$log")" ]; then
    echo "log-run: no skill named '$1'" >&2
    exit 1
fi

toplevel="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "log-run: not inside a git repo, so the run's repo cannot be named" >&2
    exit 1
}

# The remote, not the directory: this repo is checked out as ~/.claude but is
# named claude-config, and the log has always recorded the latter.
remote="$(git remote get-url origin 2>/dev/null)" || remote=""
if [ -n "$remote" ]; then
    repo="$(basename "$remote" .git)"
else
    repo="$(basename "$toplevel")"
fi

[ -f "$log" ] || printf '# Run log\n\n' >"$log"

printf '%s · %s · %s\n' "$(date +%F)" "$(basename "$repo")" "$2" >>"$log"
