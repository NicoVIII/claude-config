# Allowlist: ~/.claude is full of runtime state and secrets that Claude Code
# creates and renames across versions. Ignore everything by default so new
# state files can never be committed by accident; tracking something new is a
# deliberate opt-in below.
/*
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/LICENSE
!/README.md
!/skills

# One line per script, rather than `!/bin` un-ignoring the whole directory:
# nothing here is generated, so the allowlist can stay strict by default.
!/bin/
!/bin/runlog

# `!/skills` un-ignores everything beneath it, build output included. These
# tighten the allowlist back up; they are not an exception to it.
/skills/**/obj/
/skills/**/bin/
