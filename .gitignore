# Allowlist: ~/.claude is full of runtime state and secrets that Claude Code
# creates and renames across versions. Ignore everything by default so new
# state files can never be committed by accident; tracking something new is a
# deliberate opt-in below.
/*
!/.github
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/justfile
!/lefthook.yml
!/LICENSE
!/README.md
!/skills

!/bin

# `!/skills` and `!/bin` un-ignore everything beneath them, build output
# included. These tighten the allowlist back up; they are not an exception to it.
/skills/**/obj/
/skills/**/bin/
/bin/**/obj/
/bin/**/bin/
